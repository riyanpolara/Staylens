# Copy to .env and fill in. Never commit the real .env.

# Supabase Postgres connection (Dashboard → Project Settings → Database → URI).
# Use the pooler URI for bulk loads.
SUPABASE_DB_URL=postgresql://postgres.incjfaggypfmsegyanei:<PASSWORD>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Supabase project (already configured in .mcp.json for the Supabase MCP).
SUPABASE_PROJECT_REF=incjfaggypfmsegyanei
SUPABASE_URL=https://incjfaggypfmsegyanei.supabase.co
SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>   # server-side only, never ship to client

# OpenAI (Phase 6 embeddings).
OPENAI_API_KEY=sk-...

# Anthropic (AI chat / recommendations at the app layer).
ANTHROPIC_API_KEY=sk-ant-...

# Stripe (checkout). Leave unset to run the checkout with the built-in MOCK
# payment provider (no real charges). Set both to enable real Stripe:
#   STRIPE_SECRET_KEY               server-side only, never ship to client
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY  safe to expose; used by Stripe Elements
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google Maps JavaScript API (frontend maps). Browser key — restrict it by
# HTTP referrer in Google Cloud Console. Unset → decorative map fallback.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# Semantic search embedding provider (backend). Unset → semantic search off.
#   EMBEDDING_PROVIDER=gemini|openai|ollama|sentence-transformers
EMBEDDING_PROVIDER=
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
